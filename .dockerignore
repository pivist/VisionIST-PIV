# Trim the build context for the webui image (compose build context = repo root).
# Keep exactly what the image copies:
#   visionist_client/{pyproject.toml,README.md,LICENSE,src}
#   webui/{pyproject.toml,README.md,src,boxes}
#   webui/web/  — the SPA SOURCES: the image builds the front-end itself
#                 (webui/Dockerfile's `spa` stage), so node_modules and any
#                 local dist/ are skipped but the sources are needed.

# VCS + local artifacts
.git/
*.whl
*.mp4
*.log

# Python junk
**/__pycache__/
**/*.pyc
**/*.egg-info/
.venv/
fleet/.venv/
.venv-decode/
.venv-nb/

# webui: the SPA is built in-image, so its sources stay in the context —
# only the installed packages, a local build and stray state are skipped.
webui/web/node_modules/
webui/web/dist/
webui/web/*.map
webui/tests/
webui/data/
webui/data-docker/

# visionist_client build artifacts
visionist_client/build/
visionist_client/dist/
visionist_client/tests/

# large / unrelated to the webui image
images/
fleet/
docs/
notebooks/
protos/
